{
  "name": "spanish-invo",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "dotenv -e .dev.vars -- vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "cf-typegen": "wrangler types --env-interface Env"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/react": "^4.0.130",
    "@cloudflare/puppeteer": "^1.4.0",
