# Copy to .dev.vars for local dev (wrangler + vite). Set the same keys with `wrangler secret put` for prod.

# Direct Neon connection string. Used by drizzle-kit (migrations) only — the Worker goes through Hyperdrive.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Same URL again: local dev target for the HYPERDRIVE binding (pnpm dev loads this file into the process env).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:password@host/dbname?sslmode=require

BETTER_AUTH_SECRET=change-me-32-chars-minimum
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (Google Cloud Console → Credentials → OAuth client, type "Web application").
# Redirect URIs: http://localhost:3000/api/auth/callback/google and
# https://facturafacilapp.com/api/auth/callback/google. Without them the Google button shows an error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI — powers the in-app AI assistant (/api/ai/chat). Model is OPENAI_MODEL in wrangler.jsonc.
OPENAIAPIKEY=sk-...

# Twilio — SMS fallback for customers without WhatsApp (build step 5)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+15555550100

# PDFs use the BROWSER binding (Cloudflare Browser Rendering); no API token needed.

# Stripe — subscriptions via the Better Auth Stripe plugin. Test-mode keys locally.
# Webhook secret: `stripe listen --forward-to localhost:3000/api/auth/stripe/webhook` prints it.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# Cloudflare Turnstile on login, signup and forgot password. This is Cloudflare's
# always-pass test secret; production gets the real one via `wrangler secret put`.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
